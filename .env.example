# ==============================================================================
# AI Resume Analyzer - Environment Configuration Template
# Copy this file to '.env' and fill in your local settings before running the app.
# ==============================================================================

# Application Modes
DEBUG=true

# Security (JWT token signing key - generate a secure random string in production)
SECRET_KEY=your_jwt_secret_key_here_for_development

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# JSON Web Token (JWT) Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Administrator Seed Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of permitted origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Natural Language Processing (NLP) Models
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# SMTP Configuration (For forgot/reset password email service - leave empty for mock email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here@example.com
SMTP_PASSWORD=your_smtp_app_password_here

# Frontend Application Configuration
VITE_API_URL=http://localhost:8000
